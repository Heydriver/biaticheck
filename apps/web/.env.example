# Datenbank
DATABASE_URL=postgresql://biaticheck:biaticheck@localhost:5432/biaticheck

# Claude API (Auslesen). Ohne Schlüssel landen alle Fälle beim Experten.
ANTHROPIC_API_KEY=

# Ablage der hochgeladenen Dateien
UPLOAD_DIR=./.daten/uploads

# 32 Byte, Base64 – Verschlüsselung der Dateien. Im Produktivbetrieb Pflicht.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATEI_SCHLUESSEL=

# true = Ergebnisse erst nach Freigabe durch einen Experten sichtbar (Startphase)
FREIGABE_ERFORDERLICH=true

# Uploads pro IP und Stunde (Schutz vor Missbrauch und API-Kosten)
UPLOADS_PRO_STUNDE=10
